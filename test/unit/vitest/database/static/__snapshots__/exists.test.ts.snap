// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`exists() > should error if it receives a non-boolean result 1`] = `[Error: Encountered an error when checking to see if database "Imported" exists]`;

exports[`exists() > should error if it recieves a 400 status from the server 1`] = `[Error: Encountered an error when checking to see if database "Imported" exists]`;

exports[`exists() > should error if it recieves an unexpected status from the server 1`] = `[Error: Encountered an error when checking to see if database "Imported" exists]`;
